{
  "name": "PR Deck",
  "short_name": "PR Deck",
  "description": "Pull requests across your GitHub orgs, with dependencies, Jira and a Slack inbox.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "background_color": "#18181b",
  "theme_color": "#4f46e5",
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "shortcuts": [
    {
      "name": "Pull requests",
      "url": "/prs"
    },
    {
      "name": "Slack inbox",
      "url": "/slack"
    },
    {
      "name": "Jira tasks",
      "url": "/jira"
    }
  ]
}
